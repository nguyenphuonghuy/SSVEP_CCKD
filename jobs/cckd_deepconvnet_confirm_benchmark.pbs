#!/bin/bash
#PBS -N cckd_dcn_confirm_bm
#PBS -q sharedgpu
#PBS -l select=1:ncpus=4:mem=32gb:gpu_slots=1
#PBS -l walltime=08:00:00
#PBS -j oe

set -euo pipefail
PROJ=/gpfs0/users/gv_bvnam/projects/cckd_ssvep
PY=/gpfs0/users/gv_bvnam/envs/erd_tta_bci/bin/python
DATA_ROOT=/gpfs0/users/gv_nphuy/projects/ssvep_ensemble/data/raw/benchmark
OUT_DIR=$PROJ/results/module2/deepconvnet_confirm_benchmark_8seed
LOG=$PROJ/logs/cckd_dcn_confirm_bm_${PBS_JOBID}.log
export PYTHONUNBUFFERED=1
mkdir -p "$PROJ/logs" "$OUT_DIR"
cd "$PROJ"
{
  echo "START: $(date) | NODE: $(hostname)"
  echo "Goal: 8-seed confirmatory replication for DeepConvNet on Benchmark."
  echo "3-seed: 3C=-0.06pp(p=0.709, ns), 1C=+1.44pp(p=0.0371, sig positive)."
  echo "Checking whether the 1C positive result survives more power, to hold"
  echo "DeepConvNet to the same replication standard as ShallowConvNet/Compact-CNN."
  "$PY" training/train_cckd.py \
    --dataset benchmark --data_root "$DATA_ROOT" \
    --backbone deepconvnet --window_s 1.0 \
    --seeds 2026 2027 2028 2029 2030 2031 2032 2033 --modes relational \
    --epochs 100 --tau 4.0 --lambda_kd 1.0 --lambda_sp 100.0 \
    --output_dir "$OUT_DIR" --device cuda
  echo "END: $(date) | STATUS: SUCCESS"
} > "$LOG" 2>&1
