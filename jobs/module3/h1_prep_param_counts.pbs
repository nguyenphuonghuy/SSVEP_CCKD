#!/bin/bash
#PBS -N m3_h1_prep_params
#PBS -q sharedgpu
#PBS -l select=1:ncpus=2:mem=4gb
#PBS -l walltime=00:10:00
#PBS -j oe
#PBS -o /gpfs0/users/gv_bvnam/projects/cckd_ssvep/logs/m3_h1_prep_params.pbs.out
# H1/H2 prep: real parameter counts for 5 backbones x 2 montages (CPU only, no GPU needed).

set -euo pipefail
PROJ=/gpfs0/users/gv_bvnam/projects/cckd_ssvep
PY=/gpfs0/users/gv_bvnam/envs/erd_tta_bci/bin/python
LOG=$PROJ/logs/m3_h1_prep_params_${PBS_JOBID}.log
mkdir -p "$PROJ/logs"
cd "$PROJ"

{
  echo "START: $(date) | NODE: $(hostname)"
  "$PY" scripts/module3_count_params.py
  echo "END: $(date)"
} > "$LOG" 2>&1
