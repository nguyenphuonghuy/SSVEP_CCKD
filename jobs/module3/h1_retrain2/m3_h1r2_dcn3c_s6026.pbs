#!/bin/bash
#PBS -N m3_h1r2_dcn3c_s6026
#PBS -q sharedgpu
#PBS -l select=1:ncpus=4:mem=16gb:gpu_slots=1
#PBS -l walltime=03:00:00
#PBS -j oe
#PBS -o /gpfs0/users/gv_bvnam/projects/cckd_ssvep/logs/m3_h1r2_dcn3c_s6026.pbs.out
# H1 fix v2: beta/deepconvnet/3C split 6026, lambda_sp=100 FIXED
# (matches results/module3/analysis/rq1_backbone_effect_lsp100.csv exactly --
# the first retrain used the wrong per-split N2b-selected lambda).

set -uo pipefail
PROJ=/gpfs0/users/gv_bvnam/projects/cckd_ssvep
DATA_ROOT=/gpfs0/users/gv_nphuy/projects/ssvep_ensemble/data/raw/beta
OUT_DIR=$PROJ/results/module3/h1_retrain/beta_deepconvnet_3C_s6026
CKPT_DIR=$OUT_DIR/ckpt
LOG=$PROJ/logs/m3_h1r2_dcn3c_s6026_${PBS_JOBID}.log
export PYTHONUNBUFFERED=1
export CUDA_MPS_PIPE_DIRECTORY=/dev/null
mkdir -p "$PROJ/logs" "$OUT_DIR" "$CKPT_DIR"
cd "$PROJ"

get_ticks() {
  local stat="/proc/$1/stat"
  [ -r "$stat" ] || { echo -1; return; }
  awk -F') ' '{print $2}' "$stat" | awk '{print $12+$13}'
}

SEED_FIRST=2026
SEED_LAST=2028
DEADLINE=$(( $(date +%s) + 3*3600 - 600 ))
HANG_LIMIT_S=1200; CHECK_EVERY=60; MAX_ATTEMPTS=3
attempt=0; success=0
while [ "$attempt" -lt "$MAX_ATTEMPTS" ] && [ "$(date +%s)" -lt "$DEADLINE" ]; do
  attempt=$((attempt+1))
  echo "START attempt $attempt: $(date) | NODE: $(hostname)" >> "$LOG"
  /gpfs0/users/gv_bvnam/envs/erd_tta_bci/bin/python training/train_cckd.py \
    --dataset beta --data_root "$DATA_ROOT" \
    --backbone deepconvnet --n_bands 3 --window_s 1.0 --split_seed 6026 \
    --seeds 2026 2027 2028 \
    --students 3C --modes relational --kd_layers last \
    --epochs 100 --tau 4.0 --lambda_kd 1.0 --lambda_sp 100 \
    --output_dir "$OUT_DIR" --save_ckpt_dir "$CKPT_DIR" --device cuda >> "$LOG" 2>&1 &
  PID=$!; hang=0; last=-1; n=0
  while kill -0 "$PID" 2>/dev/null; do
    sleep $CHECK_EVERY
    t=$(get_ticks "$PID")
    if [ "$t" = "$last" ]; then hang=$((hang+CHECK_EVERY)); else hang=0; fi
    last=$t
    n=$((n+1)); if [ $((n % 10)) -eq 0 ]; then echo "GPU $(date +%H:%M) $(nvidia-smi --query-gpu=utilization.gpu,memory.used,memory.total --format=csv,noheader 2>/dev/null | tr '\n' ' ')" >> "$LOG"; fi
    if [ "$hang" -ge "$HANG_LIMIT_S" ] || [ "$(date +%s)" -ge "$DEADLINE" ]; then
      echo "KILL attempt $attempt: hang=${hang}s or deadline (ticks=$t)" >> "$LOG"
      kill -9 "$PID" 2>/dev/null; sleep 10; break
    fi
  done
  wait "$PID"; rc=$?
  if ls "$OUT_DIR"/*_seed${SEED_FIRST}-${SEED_LAST}_*_config.json >/dev/null 2>&1; then success=1; break; fi
  echo "attempt $attempt ended rc=$rc without final result" >> "$LOG"
  sleep 20
done
if [ "$success" -eq 1 ]; then
  echo "END: $(date) | STATUS: SUCCESS (attempt $attempt)" >> "$LOG"
else
  echo "END: $(date) | STATUS: FAILED after $attempt attempt(s)" >> "$LOG"; exit 1
fi
