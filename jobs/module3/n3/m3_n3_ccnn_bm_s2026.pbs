#!/bin/bash
#PBS -N m3_n3_ccnn_bm_s2026
#PBS -q sharedgpu
#PBS -l select=1:ncpus=4:mem=16gb:gpu_slots=1
#PBS -l walltime=12:00:00
#PBS -j oe
#PBS -o /gpfs0/users/gv_bvnam/projects/cckd_ssvep/logs/m3_n3_ccnn_bm_s2026.pbs.out
# Module 3 / N3: compactcnn, alternate montages (3C_PPO/3C_POO/1C_POz/1C_O1), LAST layer only
# benchmark, split_seed=2026, 8 seeds, lambda_sp=10 (validation-selected per N2b), CKA on.
# Rules (hpc_ai/docs): queue sharedgpu, gpu_slots, CUDA_MPS_PIPE_DIRECTORY=/dev/null, 1 GPU job/user.

set -uo pipefail
PROJ=/gpfs0/users/gv_bvnam/projects/cckd_ssvep
PY=/gpfs0/users/gv_bvnam/envs/erd_tta_bci/bin/python
DATA_ROOT=/gpfs0/users/gv_nphuy/projects/ssvep_ensemble/data/raw/benchmark
OUT_DIR=$PROJ/results/module3/n3/benchmark_compactcnn_altmontage_lsp10_s2026
LOG=$PROJ/logs/m3_n3_ccnn_bm_s2026_${PBS_JOBID}.log
export PYTHONUNBUFFERED=1
export CUDA_MPS_PIPE_DIRECTORY=/dev/null
mkdir -p "$PROJ/logs" "$OUT_DIR"
cd "$PROJ"

get_ticks() {
  local stat="/proc/$1/stat"
  [ -r "$stat" ] || { echo -1; return; }
  awk -F') ' '{print $2}' "$stat" | awk '{print $12+$13}'
}

DEADLINE=$(( $(date +%s) + 12*3600 - 1200 ))   # walltime minus 20 min margin
HANG_LIMIT_S=1200; CHECK_EVERY=60; MAX_ATTEMPTS=3
attempt=0; success=0
while [ "$attempt" -lt "$MAX_ATTEMPTS" ] && [ "$(date +%s)" -lt "$DEADLINE" ]; do
  attempt=$((attempt+1))
  echo "START attempt $attempt: $(date) | NODE: $(hostname)" >> "$LOG"
  "$PY" training/train_cckd.py \
    --dataset benchmark --data_root "$DATA_ROOT" \
    --backbone compactcnn --n_bands 3 --window_s 1.0 --split_seed 2026 \
    --seeds 2026 2027 2028 2029 2030 2031 2032 2033 \
    --students 3C_PPO 3C_POO 1C_POz 1C_O1 --modes relational --kd_layers last \
    --epochs 100 --tau 4.0 --lambda_kd 1.0 --lambda_sp 10 \
    --output_dir "$OUT_DIR" --device cuda >> "$LOG" 2>&1 &
  PID=$!; hang=0; last=-1; n=0
  while kill -0 "$PID" 2>/dev/null; do
    sleep $CHECK_EVERY
    t=$(get_ticks "$PID")
    if [ "$t" = "$last" ]; then hang=$((hang+CHECK_EVERY)); else hang=0; fi
    last=$t
    n=$((n+1)); if [ $((n % 10)) -eq 0 ]; then echo "GPU $(date +%H:%M) $(nvidia-smi --query-gpu=utilization.gpu,memory.used,memory.total --format=csv,noheader 2>/dev/null | tr '\n' ' ')" >> "$LOG"; fi
    if [ "$hang" -ge "$HANG_LIMIT_S" ] || [ "$(date +%s)" -ge "$DEADLINE" ]; then
      echo "KILL attempt $attempt: hang=${hang}s or deadline (ticks=$t)" >> "$LOG"
      kill -9 "$PID" 2>/dev/null; sleep 10; break
    fi
  done
  wait "$PID"; rc=$?
  if ls "$OUT_DIR"/cckd_*.json >/dev/null 2>&1; then success=1; break; fi
  echo "attempt $attempt ended rc=$rc without final result (checkpoint.json keeps finished seeds)" >> "$LOG"
  sleep 20
done
if [ "$success" -eq 1 ]; then
  echo "END: $(date) | STATUS: SUCCESS (attempt $attempt)" >> "$LOG"
else
  echo "END: $(date) | STATUS: FAILED after $attempt attempt(s)" >> "$LOG"; exit 1
fi
