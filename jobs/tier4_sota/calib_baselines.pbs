#!/bin/bash
#PBS -N cckd_calib_sota
#PBS -q sharedgpu
#PBS -l select=1:ncpus=4:mem=32gb:gpu_slots=1
#PBS -l walltime=04:00:00
#PBS -j oe

set -euo pipefail
PROJ=/gpfs0/users/gv_bvnam/projects/cckd_ssvep
PY=/gpfs0/users/gv_bvnam/envs/erd_tta_bci/bin/python
DATA_ROOT=/gpfs0/users/gv_nphuy/projects/ssvep_ensemble/data/raw/benchmark
LOG=$PROJ/logs/cckd_calib_sota_${PBS_JOBID}.log
export PYTHONUNBUFFERED=1
mkdir -p "$PROJ/logs"
cd "$PROJ"
{
  echo "START: $(date) | NODE: $(hostname)"
  echo "Tier 4: lambda calibration sweep for FitNets/Attention-Transfer baselines"
  echo "on Benchmark-3C only (3 seeds, full 100 epochs), before committing to"
  echo "the full 8-seed x 2-dataset x 2-config comparison."
  for MODE in fitnets attention; do
    for LSP in 0.1 1 10 100 1000; do
      echo "=== mode=$MODE lambda_sp=$LSP ==="
      OUT_DIR=$PROJ/results/module2/sota_calib/${MODE}_lsp${LSP}
      mkdir -p "$OUT_DIR"
      "$PY" training/train_cckd.py \
        --dataset benchmark --data_root "$DATA_ROOT" \
        --backbone fbtcnn --n_bands 3 --window_s 1.0 \
        --seeds 2026 2027 2028 --modes $MODE --students 3C \
        --epochs 100 --tau 4.0 --lambda_sp $LSP \
        --output_dir "$OUT_DIR" --device cuda
    done
  done
  echo "END: $(date) | STATUS: SUCCESS"
} > "$LOG" 2>&1
